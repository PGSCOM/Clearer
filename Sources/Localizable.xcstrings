            "value" : "Groups found"
          }
        }
      }
    },
    "Has denegado el acceso a fotos. Actívalo en Ajustes para que Clearer pueda revisar tu fototeca." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've denied access to your photos. Turn it on in Settings so Clearer can look through your library."
